# =============================================================================
# API KEYS
# =============================================================================

# OpenAI API key
OPENAI_API_KEY=

# Tavily API key, used for web searches
TAVILY_API_KEY=


# =============================================================================
# BRAND
# =============================================================================

# Name of the cinema, used in generated posts (e.g. "Cinema Roma")
CINEMA_NAME=Cinema Moderno

# Desidered Language of the posts
POST_LANGUAGE=Italian
# =============================================================================
# MODELS
# =============================================================================

# Default OpenAI model used by all nodes
DEFAULT_MODEL=gpt-4o-mini

# Optional model override for a specific node.
# Convention: MODEL_<NODE_NAME_IN_UPPERCASE>
#
# Example: the "write_post" node uses gpt-4o instead of the default model.
MODEL_WRITE_POST=gpt-4o


# =============================================================================
# OUTPUT
# =============================================================================

# Directory where generated post JSON files are saved
SAVE_FOLDER=./output/posts

# Directory where generated images are saved
IMAGES_FOLDER=./output/images


# =============================================================================
# DATA
# =============================================================================

# Path to the movies dataset
MOVIES_CSV_PATH=./data/movies.csv

# Path to the generated posts history
HISTORY_PATH=./data/history.json


# =============================================================================
# SEARCH & DISCOVERY
# =============================================================================

# Maximum number of posts generated per run
MAX_POSTS_PER_RUN=1

# Number of results returned by the broad initial search
BROAD_SEARCH_RESULTS=10

# Number of results used for movie-related searches
MOVIE_SEARCH_RESULTS=6

# Number of results used for focused searches
FOCUSED_SEARCH_RESULTS=4

# Number of days of history considered when avoiding recently used content
HISTORY_WINDOW_DAYS=15

# Tavily time_range filter for the generic-news discovery search
BROAD_SEARCH_TIME_RANGE=week

# Tavily time_range filter for per-movie discovery searches
MOVIE_SEARCH_TIME_RANGE=month

# Path to the record of previously-seen search result URLs (used to avoid re-surfacing old articles)
SEEN_URLS_PATH=./data/seen_urls.json

# Number of days a seen URL is remembered and excluded from future searches
SEEN_URLS_WINDOW_DAYS=45

# Maximum number of attempts for the discovery phase
MAX_DISCOVERY_ATTEMPTS=2

# how many days after release a movie is still considered "eligible"
MOVIE_WINDOW_DAYS_BEFORE=4

# how many days before release a movie starts being considered
MOVIE_WINDOW_DAYS_AFTER=4

# max approved posts ever generated for a single movie
MAX_POSTS_PER_MOVIE=5

# =============================================================================
# IMAGE GENERATION
# =============================================================================

# Path to the brand template used for image generation
BRAND_TEMPLATE_PATH=./data/brand_template.png

# Image generation model
IMAGE_MODEL=gpt-image-2

# Generated image dimensions
IMAGE_SIZE=1024x1024

# Image generation quality
IMAGE_QUALITY=low


# =============================================================================
# PUBLISHING
# =============================================================================

# Instagram user Id
IG_USER_ID=

# Meta Instagram access token from custom app on meta developers platform
IG_ACCESS_TOKEN=

# Meta Graph API version to call
GRAPH_API_VERSION=v21.0

#Cloudinary api key
CLOUDINARY_API_KEY=

#Cloudinary api secret
CLOUDINARY_API_SECRET=   

#Cloudinary cloud name
CLOUDINARY_CLOUD_NAME=